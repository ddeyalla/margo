{
  "name": "rigg-learn",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "electron/main.cjs",
  "description": "Read your own books with an AI tutor beside you.",
  "author": "rigg",
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "next dev -H 127.0.0.1",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "app": "electron .",
    "app:server": "next build && node electron/assemble-server.mjs",
    "app:build": "npm run app:server && electron-builder --mac dmg --arm64"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@excalidraw/excalidraw": "^0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "^2.2.2",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@napi-rs/canvas": "^1.1.1",
    "@ui-sdk/core": "^0.1.0-beta.1",
    "@ui-sdk/react": "^0.1.0-beta.1",
    "@xmldom/xmldom": "^0.9.12",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "katex": "^0.19.1",
    "lucide-react": "^1.72.0",
    "mermaid": "^12.2.0",
    "next": "16.4.6",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sherpa-onnx-node": "2.0.1",
    "ts-fsrs": "5.2.3"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "45.2.0",
    "electron-builder": "26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "app.rigglearn",
    "productName": "rigg learn",
    "directories": {
      "output": "dist-app"
    },
    "asar": true,
    "files": [
      "electron/**/*",
      "!electron/icon.svg",
      "!electron/assemble-server.mjs",
      "!electron/after-pack.cjs",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist-app/server",
        "to": "server"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "electron/icon.icns",
      "identity": null,
      "category": "public.app-category.education",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "rigg learn uses the microphone so you can speak to the tutor. Your voice is turned into text on this Mac and is never sent anywhere."
      }
    },
    "dmg": {
      "title": "rigg learn"
    },
    "npmRebuild": false,
    "afterPack": "electron/after-pack.cjs"
  }
}
