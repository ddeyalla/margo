# Optional: you can choose these folders in the app instead. Values here win over the app.
# Folder of your books. Scanned recursively for .epub and .pdf files.
BOOKS_DIR=/Users/you/Books

# Folder for your notes. Point it at a folder inside your Obsidian vault to see notes there.
NOTES_DIR=/Users/you/Obsidian/Reading

# Only needed for the "API" tutor provider. Claude Code and Codex use their own sign-in.
ANTHROPIC_API_KEY=

# Where the app keeps its data and settings. Defaults to ./data. Must be an absolute path.
# DATA_DIR=/Users/you/Library/Application Support/rigg-learn
